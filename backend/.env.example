# BugDNA Backend Environment Variables (Local Development Example)
# Copy to .env and adjust values for your environment. NEVER commit .env to git.

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/bugdna?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=bugdna
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Dev Authentication Credentials (no Spring Security)
BUGDNA_DEV_USER=dev
BUGDNA_DEV_PASSWORD=password123

# CORS Origins (comma-separated)
BUGDNA_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# AI Service Configuration
AI_PROVIDER=mock
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

